rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Restaurants collection - users can only access their own restaurant
    match /restaurants/{restaurantId} {
      // Allow users to read/write their own restaurant document
      allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      
      // Menu Categories subcollection (used by MenuManagement and POS)
      match /menuCategories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        
        // Items within each category
        match /items/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        }
      }
      
      // Orders subcollection (used by POS and Orders components)
      match /orders/{orderId} {
        // Restaurant owner can read/write their orders
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        // Customers can read their own orders (matched by customerId)
        allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
        // Public can create orders (for customers ordering online)
        allow create: if true;
      }
      
      // Layout subcollection (used by TableLayout component)
      match /layout/{layoutId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }
      
      // Website subcollection (used by WebsiteBuilder)
      match /website/{websiteId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }
      
      // Locations subcollection (used for multi-location restaurants)
      match /locations/{locationId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        
        // Layout subcollection within each location
        match /layout/{layoutId} {
          allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        }
        
        // Website subcollection within each location (for multi-location website builder)
        match /website/{websiteId} {
          allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        }
        
        // Menu Categories within each location (for multi-location)
        match /menuCategories/{categoryId} {
          allow read, write: if request.auth != null && request.auth.uid == restaurantId;
          
          match /items/{itemId} {
            allow read, write: if request.auth != null && request.auth.uid == restaurantId;
          }
        }
        
        // Orders within each location (for multi-location)
        match /orders/{orderId} {
          allow read, write: if request.auth != null && request.auth.uid == restaurantId;
          // Customers can read their own orders (matched by customerId)
          allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
          allow create: if true;
        }
      }
      
      // Reimbursements subcollection
      match /reimbursements/{reimbursementId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }
      
      // Activity logs subcollection
      match /activities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }
      
      // Customers subcollection (for customer portal)
      match /customers/{customerId} {
        // Customer can read/write their own data
        allow read, write: if request.auth != null && request.auth.uid == customerId;
        // Allow authenticated users to create their customer record
        allow create: if request.auth != null && request.auth.uid == customerId;
      }

      // Promotions subcollection
      match /promotions/{promotionId} {
        // Restaurant owner can CRUD
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
        // Public can read published promotions (for customer portal)
        allow read: if resource.data.isPublished == true;
      }

      // Promotion Claims subcollection
      match /promotionClaims/{claimId} {
        // Restaurant owner can read all claims
        allow read: if request.auth != null && request.auth.uid == restaurantId;
        // Customer can read their own claims
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      }

      // Customer Rewards subcollection
      match /customerRewards/{rewardId} {
        allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid == restaurantId);
      }

      // Customer Spins subcollection
      match /customerSpins/{customerId} {
        allow read: if request.auth != null && (request.auth.uid == customerId || request.auth.uid == restaurantId);
      }

      // Rewards Config subcollection
      match /rewardsConfig/{configId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }

      // Settings subcollection (business listings, etc.)
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }

      // Business reviews cache (from Yelp, Google, Apple)
      match /businessReviews/{reviewId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }

      // Visibility tasks (AI-generated improvement tasks)
      match /visibilityTasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }

      // Social posts
      match /socialPosts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == restaurantId;
      }
    }
    
    // Social media posts - users can only access their own
    match /socialMediaPosts/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Website settings - users can only access their own
    match /websiteSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Social connections - users can only access their own
    match /socialConnections/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ==========================================
    // Admin Platform Configuration
    // ==========================================
    
    // Platform configuration - read by all (for pricing display), write by admins only
    match /platformConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Draft configuration - admins only
    match /platformConfigDraft/{docId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Scheduled changes - admins only
    match /scheduledChanges/{docId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Analytics events - anyone can write (for tracking), only admins can read
    match /analyticsEvents/{eventId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if true; // Public can log analytics events
      allow update, delete: if false; // Events are immutable
    }
    
    // Platform analytics - admins can read, public can write for real-time updates
    match /platformAnalytics/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if true; // Allow real-time aggregate updates from client
    }
    
    // Admin users collection - read own document only
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Managed manually via Firebase Console
    }
  }
}
