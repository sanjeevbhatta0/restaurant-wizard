rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: validate file is an allowed image type and under size limit
    // SVG removed — SVG files can contain embedded <script> tags (stored XSS vector)
    function isValidImage() {
      return request.resource.contentType.matches('image/(png|jpeg|gif|webp)')
        && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    match /websites/{restaurantId}/{fileName} {
      allow read: if true; // Public: website hero images, logos
      allow create, update: if request.auth != null &&
                   request.auth.uid == restaurantId &&
                   isValidImage();
      allow delete: if request.auth != null &&
                   request.auth.uid == restaurantId;
    }

    match /images/{restaurantId}/{fileName} {
      allow read: if true; // Public: menu item images
      allow create, update: if request.auth != null &&
                   request.auth.uid == restaurantId &&
                   isValidImage();
      allow delete: if request.auth != null &&
                   request.auth.uid == restaurantId;
    }

    // Menu item images: restaurants/{uid}/menuItems/{categoryId}/{file}
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true; // Public: menu images served to customers
      allow create, update: if request.auth != null &&
                   request.auth.uid == restaurantId &&
                   isValidImage();
      allow delete: if request.auth != null &&
                   request.auth.uid == restaurantId;
    }

    // Social media post images — only owner can read/write (may contain drafts)
    match /social-posts/{restaurantId}/{allPaths=**} {
      allow read: if request.auth != null &&
                  request.auth.uid == restaurantId;
      allow create, update: if request.auth != null &&
                   request.auth.uid == restaurantId &&
                   isValidImage();
      allow delete: if request.auth != null &&
                   request.auth.uid == restaurantId;
    }
  }
}
