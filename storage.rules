rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /websites/{restaurantId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.auth.uid == restaurantId;
    }
    
    match /images/{restaurantId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.auth.uid == restaurantId;
    }
  }
} 