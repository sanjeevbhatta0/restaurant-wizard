{
  "name": "restaurant-wizard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@stripe/terminal-js": "^0.26.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.17.1",
    "axios": "^1.8.4",
    "bootstrap": "^5.1.3",
    "bootstrap-icons": "^1.11.3",
    "cors": "^2.8.5",
    "firebase": "^9.23.0",
    "handlebars": "^4.7.8",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^18.3.1",
    "react-facebook-login": "^4.1.1",
    "react-icons": "^4.12.0",
    "react-joyride": "^3.0.2",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.7",
    "twitter-api-v2": "^1.15.1",
    "web-vitals": "^2.1.4",
    "ws": "^8.20.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "CI=true react-scripts test --watchAll=false --passWithNoTests && REACT_APP_FIREBASE_ENV=development react-scripts build",
    "build:only": "REACT_APP_FIREBASE_ENV=development react-scripts build",
    "build:prod": "REACT_APP_FIREBASE_ENV=production CI=true react-scripts test --watchAll=false --passWithNoTests && REACT_APP_FIREBASE_ENV=production react-scripts build",
    "build:prod:only": "REACT_APP_FIREBASE_ENV=production react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watchAll=false --testPathPattern=__tests__/unit",
    "test:integration": "react-scripts test --watchAll=false --testPathPattern=__tests__/integration",
    "test:e2e": "FIRESTORE_EMULATOR_HOST=localhost:8080 react-scripts test --watchAll=false --runInBand --forceExit --testPathPattern=__tests__/e2e",
    "test:pos": "react-scripts test --watchAll=false --testPathPattern=__tests__/(unit|integration|e2e)",
    "test:widget": "react-scripts test --watchAll=false --testPathPattern=__tests__/(unit|integration|e2e)/(embedApp|widgetOrderFlow|widgetE2E|websiteServing|websiteOrderFlow|websiteOrderE2E)",
    "test:listings": "react-scripts test --watchAll=false --testPathPattern=__tests__/(unit|integration)/(businessListings|businessListingsFlow)",
    "test:service-mode": "react-scripts test --watchAll=false --testPathPattern=__tests__/(unit|integration)/(serviceMode|counterServiceFlow)",
    "test:2fa": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration)/(twoFactorAuth|twoFactorAuthFlow)'",
    "test:social": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration)/(socialMedia|socialMediaFlow)'",
    "test:access-control": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration|e2e)/(accessControl|accessControlFlow|accessControlE2E)'",
    "test:stripe-connect": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration|e2e)/(stripeConnect|stripeConnectFlow|stripeConnectE2E)'",
    "test:reviews": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration|e2e)/(reviews|reviewsFlow|reviewsE2E)'",
    "test:receipt": "react-scripts test --watchAll=false --testPathPattern='__tests__/(unit|integration)/(receipt|receiptFlow)'",
    "test:admin": "FIRESTORE_EMULATOR_HOST=localhost:8080 react-scripts test --watchAll=false --runInBand --forceExit --testPathPattern='__tests__/(unit|integration|e2e)/(platformAdmin|platformAdminFlow|platformAdminE2E)'",
    "test:ci": "CI=true react-scripts test --watchAll=false --coverage --passWithNoTests",
    "eject": "react-scripts eject",
    "dev": "concurrently \"npm start\" \"firebase emulators:start\"",
    "relay": "node scripts/lan-relay.js",
    "emulate": "firebase emulators:start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{js,jsx}",
      "<rootDir>/src/**/*.test.{js,jsx}"
    ]
  },
  "devDependencies": {
    "aria-query": "^5.3.2",
    "concurrently": "^9.1.2",
    "firebase-admin": "^13.7.0"
  }
}
